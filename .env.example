# Shared secret that Strapi sends in a custom webhook header. At least 16 characters.
STRAPI_SYNC_SECRET=change-me-to-a-long-random-string
# Header name to read it from (default: X-Sync-Secret).
# STRAPI_SYNC_SECRET_HEADER=X-Sync-Secret
# Path to the YAML mapping (default: mapping.yaml).
STRAPI_SYNC_MAPPING=mapping.yaml

# Either "meilisearch" or "webhook".
STRAPI_SYNC_TARGET=meilisearch

# Required when the target is meilisearch.
MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=

# Required when the target is webhook.
# WEBHOOK_TARGET_URL=http://localhost:9000/ingest
# WEBHOOK_TARGET_TOKEN=
